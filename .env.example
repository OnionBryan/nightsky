# Night Sky Viewer & JPSS Constellation Tracker
# Copy to .env and adjust as needed

# Service ports (change if you have conflicts)
ORBIT_API_PORT=5050
NIGHTSKY_API_PORT=5051
ORBIT_FRONTEND_PORT=8080
NIGHTSKY_FRONTEND_PORT=8081

# Host binding (0.0.0.0 for network access, 127.0.0.1 for local only)
HOST=0.0.0.0

# Browser to open on start (chrome, firefox, safari, or empty for default)
BROWSER=
